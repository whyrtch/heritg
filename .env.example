# Copy to .env.local and fill in. Never commit .env.local: DATABASE_URL is a secret.

# PostgreSQL connection string (server only; never put it in a NEXT_PUBLIC_* variable).
# Local development: `docker compose up -d`, then `npm run db:migrate`.
DATABASE_URL=postgres://heritg:heritg@localhost:5432/heritg

# The public origin. State-changing requests (including login) must come from exactly this origin.
# Required in production; keep localhost for local development.
APP_URL=http://localhost:3000

# Canonical URL for page metadata (canonical and Open Graph links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# How many reverse proxies append to X-Forwarded-For (usually 1 behind a proxy). Default 0.
# TRUSTED_PROXY_HOPS=0

# Database connection pool size. Default 10.
# DATABASE_POOL_MAX=10

# --- One-time Firebase import only (see README "Moving data from Firebase") ---
# Remove these after the import. The service-account key file stays outside the repository.
# OWNER_EMAIL=
# FIREBASE_OWNER_UID=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=
